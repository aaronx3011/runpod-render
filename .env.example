# Copy to .env and fill in. Never commit .env. Dev values for the local stack live in devstack/compose.yaml.

# --- RunPod (task #483)
RUNPOD_API_KEY=
RUNPOD_API_BASE=https://api.runpod.ai
RUNPOD_ENDPOINT_T2V=          # endpoint id of fasth3-t2v (created in #487)
RUNPOD_ENDPOINT_OMNI=         # endpoint id of fasth3-omni (created in #488)

# --- Object storage: Cloudflare R2 (S3-compatible), bucket-scoped token
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=runpod-render
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Control plane
DATABASE_URL=postgresql+psycopg://render:<password>@localhost:5432/render
PUBLIC_BASE_URL=https://render-dev.<domain>   # what RunPod workers call back to (Cloudflare Tunnel, #494)
ATTEMPT_TOKEN_SECRET=                         # generate: python -c "import secrets;print(secrets.token_hex(32))"
RUNPOD_WEBHOOK_SECRET=                        # same; appended to the webhook URL path
MAX_ACTIVE_RENDERS=7

# --- Pinned model revisions (HF commit SHAs the endpoints cache)
MODEL_REVISION_T2V=
MODEL_REVISION_OMNI=

# --- Optional
HF_TOKEN=                                     # only if a model turns out to be gated
